{
  "manifest_version": 3,
  "name": "Moment Insight N Shopping Rank",
  "version": "1.0.47",
  "description": "현재 Chrome 프로필의 네이버쇼핑 공개 검색 결과로 모먼트인사이트 오가닉 순위를 갱신합니다.",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://search.shopping.naver.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Moment Insight N Shopping Rank",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  }
}
