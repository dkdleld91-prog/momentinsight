PORT=8790

# NAVER Search Ad API: absolute monthly search volume, CTR, competition
NAVER_SEARCHAD_API_KEY=your-searchad-api-key
NAVER_SEARCHAD_SECRET_KEY=your-searchad-secret-key
NAVER_SEARCHAD_CUSTOMER_ID=your-searchad-customer-id

# NAVER API Hub: migrated Search, Search Trend, Shopping Insight
# Production is pinned to Hub. Invalid or incomplete Hub credentials must fail closed.
NAVER_API_HUB_MODE=hub
NAVER_API_HUB_CLIENT_ID=your-naver-api-hub-client-id
NAVER_API_HUB_CLIENT_SECRET=your-naver-api-hub-client-secret

# Production dual path: verified immediate top window + signed local 300 worker.
# Never commit the worker secret; keep the same 32+ byte value in Vercel and
# the macOS Keychain service co.kr.momentinsight.naver-shopping-local-worker.
NAVER_SHOPPING_RANK_MODE=hybrid_local_worker
MI_NAVER_SHOPPING_LOCAL_WORKER_ENABLED=true
MI_NAVER_SHOPPING_LOCAL_WORKER_SECRET=your-32-byte-or-longer-worker-secret
MI_NAVER_SHOPPING_PROVIDER_TIMEOUT_MS=90000

# Diagnostic/development only: NAVER_SHOPPING_RANK_MODE=mobile_top_fallback
# This first-party path verifies exact SAS hits only through the contiguous top-50
# window. A miss preserves the last verified rank and it never qualifies a full
# 300-rank Production release. Do not combine it with provider URL/key values.

# Alternative only when a separately verified full-window provider exists:
# NAVER_SHOPPING_RANK_MODE=provider
# NAVER_SHOPPING_RANK_API_URL=https://your-collector.example.com/rank/naver-shopping
# NAVER_SHOPPING_RANK_API_KEY=your-shared-shopping-rank-collector-secret

# Optional. Naver Place rank needs an external collector because official OpenAPI
# does not return a reliable place URL/placeId rank match.
NAVER_PLACE_RANK_API_URL=https://your-collector.example.com/rank/naver-place
NAVER_PLACE_RANK_API_KEY=your-shared-place-rank-collector-secret
NAVER_PLACE_RANK_TIMEOUT_MS=90000

# Optional. Use comma-separated allowed origins in production.
# Example: https://momentinsight.kr,https://www.momentinsight.kr
MI_ALLOWED_ORIGINS=https://insight.momentlabs.co.kr

# Production keyword lookup requires this to be true.
MI_KEYWORD_API_ENABLED=true

# Optional local/prod preflight. When true, check:env fails if Naver keys are missing.
MI_REQUIRE_NAVER_ENV=true
